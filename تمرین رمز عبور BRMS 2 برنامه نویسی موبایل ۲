برنامه ای بنویسید
یک رمز عبور را در یک متغییر ذهیره کند و از کاربر رمز بخواهد و تا زمانی که رمز درست وارد نشده باشد به شما پیغام رمز نادرست است بدهد
و در صورت درست بودن پیغام درست است نشان بدهد


import 'dart:io';

void main() {
  String password = "1234";
  String input;

  do {
    print("رمز عبور را وارد کنید:");
    input = stdin.readLineSync()!;

    if (input != password) {
      print("رمز نادرست است");
    }

  } while (input != password);

  print("رمز درست است");
}
